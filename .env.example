# AgroGrowth Platform Environment Variables
# Copy this file to .env and fill in your actual values

# ================================
# DEPLOYMENT CONFIGURATION
# ================================
NODE_ENV=development
PORT=8080

# Cloud services toggle
VITE_USE_CLOUD_SERVICES=false
VITE_FALLBACK_TO_MOCK=true

# ================================
# API CONFIGURATION
# ================================
# Local development
VITE_API_URL=http://localhost:8080/api

# Production (set in cloud platform)
# VITE_API_URL=https://your-app.vercel.app/api

# ================================
# AI SERVICES (CLOUD)
# ================================
# Railway deployment URLs (set these when deploying to cloud)
VITE_SOIL_ANALYSIS_URL=https://agrogrowth-soil-analysis.railway.app
VITE_CROP_RECOMMENDATION_URL=https://agrogrowth-crop-recommendation.railway.app
VITE_IMAGE_DIAGNOSIS_URL=https://agrogrowth-image-diagnosis.railway.app
VITE_MARKET_PREDICTION_URL=https://agrogrowth-market-prediction.railway.app
VITE_INTELLIGENT_AGENT_URL=https://agrogrowth-intelligent-agent.railway.app

# ================================
# DATABASE CONFIGURATION
# ================================
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrogrowth

# Supabase (Cloud)
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Neon (Alternative cloud PostgreSQL)
# DATABASE_URL=postgresql://username:password@hostname.neon.tech/dbname?sslmode=require

# ================================
# REDIS CONFIGURATION
# ================================
# Local Redis
REDIS_URL=redis://localhost:6379

# Upstash (Cloud Redis)
# REDIS_URL=rediss://default:password@region-xxx.upstash.io:6380
# UPSTASH_REDIS_REST_URL=https://region-xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ================================
# EXTERNAL API KEYS
# ================================
# Weather service
WEATHER_API_KEY=your_weather_api_key

# Satellite imagery
SATELLITE_API_KEY=your_satellite_api_key

# OpenAI for chat features
OPENAI_API_KEY=your_openai_api_key

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ================================
# SECURITY
# ================================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Session configuration
SESSION_SECRET=your-session-secret

# ================================
# MONITORING & ANALYTICS
# ================================
# Sentry error tracking
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog analytics
POSTHOG_KEY=phc_xxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# ================================
# AI MODEL CONFIGURATION
# ================================
# Model storage paths
MODEL_PATH=/app/models
MODEL_CACHE_SIZE=500MB

# Model performance settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
MODEL_INFERENCE_TIMEOUT=60000

# ================================
# FILE UPLOAD & STORAGE
# ================================
# Maximum file sizes (in MB)
MAX_IMAGE_SIZE=10
MAX_FILE_SIZE=50

# Storage configuration
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=supabase
# STORAGE_PROVIDER=s3

# AWS S3 (if using S3)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=agrogrowth-uploads

# Supabase Storage (if using Supabase)
# SUPABASE_STORAGE_BUCKET=uploads

# ================================
# FEATURE FLAGS
# ================================
# PWA features
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BACKGROUND_SYNC=true

# Analytics and tracking
ENABLE_ANALYTICS=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true

# AI features
ENABLE_AI_CHAT=true
ENABLE_REAL_TIME_ANALYSIS=true
ENABLE_PREDICTIVE_ANALYTICS=true

# ================================
# LOGGING
# ================================
LOG_LEVEL=info
LOG_FORMAT=json

# Development logging
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# ================================
# PERFORMANCE
# ================================
# Cache settings
CACHE_TTL=3600
REDIS_CACHE_TTL=1800

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOCALIZATION
# ================================
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en,fr

# RTL support
DEFAULT_DIRECTION=rtl

# ================================
# DEVELOPMENT
# ================================
# Hot reload for development
VITE_HMR_PORT=24678

# Development tools
ENABLE_DEV_TOOLS=true
ENABLE_REDUX_DEVTOOLS=true

# Testing
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/agrogrowth_test

# ================================
# PRODUCTION OPTIMIZATIONS
# ================================
# Build settings (set by build system)
# VITE_APP_VERSION=1.0.0
# VITE_BUILD_TIME=2024-01-01T00:00:00Z
# VITE_COMMIT_HASH=abc123

# CDN settings
# CDN_URL=https://cdn.agrogrowth.com
# STATIC_ASSETS_URL=https://assets.agrogrowth.com

# ================================
# EMAIL CONFIGURATION
# ================================
# SMTP settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@agrogrowth.com

# SendGrid (alternative)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ================================
# NOTIFICATIONS
# ================================
# Push notification keys (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@agrogrowth.com

# ================================
# BACKUP & MAINTENANCE
# ================================
# Backup settings
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="نعتذر، الموقع تحت الصيانة حالياً"
