# Example environment variables for AgroGrowth
# Copy this file to .env and fill real values. DO NOT commit real secrets to the repository.

# Database (recommended to use the supplied Supabase connection pooling URL in CI or runtime)
DATABASE_URL=
DIRECT_URL=

# Supabase (server)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Vite / client-side envs (must be prefixed with VITE_ to reach the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server runtime
NODE_ENV=development
PORT=5000
PING_MESSAGE=ping

# CORS: comma-separated list of allowed origins in production.
# In development all origins are allowed.
# CORS_ORIGINS=https://agrogrowth.tn,https://www.agrogrowth.tn
CORS_ORIGINS=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30

# Privileged maintenance endpoints (demo/admin user provisioning, auth debug).
# - Set ADMIN_API_TOKEN to require the x-admin-token header on these endpoints.
#   Prefer ADMIN_API_TOKEN: a dedicated secret that is safe to send as a header.
#   SUPABASE_SERVICE_ROLE_KEY is accepted as a fallback for older clients, but it
#   grants full database access and should not be handed around. Comparison is
#   constant-time in both cases.
# - When unset: they are allowed ONLY in non-production AND only when
#   ENABLE_DEMO_ENDPOINTS is not "false". In production they are disabled.
ADMIN_API_TOKEN=
ENABLE_DEMO_ENDPOINTS=false

# ---------------------------------------------------------------------------
# AI providers (optional). When unset, AgroGrowth uses its deterministic
# rule-based agronomy engine and reports dataSource="rule-based" instead of
# pretending an AI analysis succeeded.
#
# Two protocol families are supported. Set AI_PROVIDER to pick one explicitly;
# if it is omitted the protocol is inferred from which credential is present.
#   AI_PROVIDER=openai-compatible   (OpenAI, OpenRouter, Groq, Together, Ollama, vLLM)
#   AI_PROVIDER=gemini              (native Google Gemini generateContent API)
#
# Text and vision models are configured separately so a text-only model is never
# used for image diagnosis:
#   AI_TEXT_MODEL    model for chat / explanations      (e.g. gpt-4o-mini)
#   AI_VISION_MODEL  MUST be a vision-capable model      (e.g. gpt-4o, gemini-flash-latest)
#   AI_MODEL         shared fallback for both, when the two above are unset
#
# The built-in defaults are models the providers still serve. gemini-2.0-flash
# (shut down) and gemini-1.5-flash (discontinued) will 404 — do not pin them.
#
# Only the credential for the selected provider is required. Provider-specific
# key names are also accepted so an existing deployment needs no renaming.
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Provider-specific credentials (use the one matching AI_PROVIDER):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# GEMINI_API_KEY=            (or GOOGLE_API_KEY)

# Provider request policy (optional).
# Retries use bounded exponential backoff with full jitter; a 429/5xx that
# carries a Retry-After header is honoured (capped by AI_RETRY_MAX_MS).
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RETRY_BASE_MS=400
AI_RETRY_MAX_MS=30000

# Opt-in REAL provider smoke tests (never run in CI by default; they spend quota):
# AI_LIVE_TESTS=1
# AI_LIVE_VISION_TESTS=1
# AI_LIVE_TEST_IMAGE=/path/to/approved/leaf.jpg

# Self-hosted AI microservices (optional). When unset, the API falls back to
# the rule-based engine instead of fabricating results.
SOIL_ANALYSIS_URL=http://localhost:8001
CROP_RECOMMENDATION_URL=http://localhost:8002
IRRIGATION_OPTIMIZATION_URL=http://localhost:8008
PEST_CONTROL_URL=http://localhost:8007
WEATHER_YIELD_INTELLIGENCE_URL=http://localhost:8006
IMAGE_DIAGNOSIS_URL=http://localhost:8003
MARKET_FORECAST_URL=http://localhost:8004
SMART_ASSISTANT_URL=http://localhost:8005
SMART_MARKETPLACE_URL=http://localhost:8006

# Weather provider. Open-Meteo requires no API key; this is only used when a
# keyed provider is configured.
WEATHER_API_KEY=

# Notes:
# - Keep real secrets out of source control. Use CI/hosting env vars.
# - After copying `.env.example` to `.env`, restart the dev server.
