# Example environment variables for AgroGrowth
# Copy this file to .env and fill real values. DO NOT commit real secrets to the repository.

# Database (recommended to use the supplied Supabase connection pooling URL in CI or runtime)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.example.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.example.supabase.co:5432/postgres"

# Supabase (server)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Vite / client-side envs (prefixed with VITE_ or NEXT_PUBLIC_ depending on usage)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional telemetry / feature flags
NODE_ENV=development
PORT=8080

# Notes:
# - Keep real secrets out of source control. Use CI/hosting env vars or the dev server env to store secrets.
# - After copying `.env.example` to `.env`, restart the dev server so it picks up new env vars.
# - You can set these values in GitHub Actions/Netlify/Vercel or via the dev server control if available.
