# Example environment variables for AgroGrowth
# Copy this file to .env and fill real values. DO NOT commit real secrets to the repository.

# Database (recommended to use the supplied Supabase connection pooling URL in CI or runtime)
DATABASE_URL=
DIRECT_URL=

# Supabase (server)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Vite / client-side envs (must be prefixed with VITE_ to reach the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server runtime
NODE_ENV=development
PORT=5000
PING_MESSAGE=ping

# CORS: comma-separated list of allowed origins in production.
# In development all origins are allowed.
# CORS_ORIGINS=https://agrogrowth.tn,https://www.agrogrowth.tn
CORS_ORIGINS=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30

# Privileged maintenance endpoints (demo/admin user provisioning, auth debug).
# - Set ADMIN_API_TOKEN to require the x-admin-token header on these endpoints.
# - When unset: they are allowed ONLY in non-production AND only when
#   ENABLE_DEMO_ENDPOINTS is not "false". In production they are disabled.
ADMIN_API_TOKEN=
ENABLE_DEMO_ENDPOINTS=false

# AI provider (optional). When unset, AgroGrowth uses its deterministic
# rule-based agronomy engine and reports dataSource="rule-based".
# Supported: openai-compatible endpoints (OpenAI, OpenRouter, Groq, local...).
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Self-hosted AI microservices (optional). When unset, the API falls back to
# the rule-based engine instead of fabricating results.
SOIL_ANALYSIS_URL=http://localhost:8001
CROP_RECOMMENDATION_URL=http://localhost:8002
IMAGE_DIAGNOSIS_URL=http://localhost:8003
MARKET_FORECAST_URL=http://localhost:8004
SMART_ASSISTANT_URL=http://localhost:8005
SMART_MARKETPLACE_URL=http://localhost:8006

# Weather provider. Open-Meteo requires no API key; this is only used when a
# keyed provider is configured.
WEATHER_API_KEY=

# Notes:
# - Keep real secrets out of source control. Use CI/hosting env vars.
# - After copying `.env.example` to `.env`, restart the dev server.
