# EAS uploads only the source and assets required to build the app.
# .easignore takes precedence over .gitignore, so keep all essential exclusions here.

# Dependencies and generated output
node_modules/
.expo/
dist/
web-build/
coverage/
*.tsbuildinfo

# Native folders are generated by Expo prebuild in EAS
android/
ios/

# Local credentials and environment files
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Tests and local development metadata (not required for the app bundle)
tests/
.github/
.git/
.vscode/
.claude/
.DS_Store
*.log
*.tmp

# Repository documentation (not used by Metro or native compilation)
README.md
AGENTS.md
LICENSE

# Heavy local archives and previous build outputs (never needed by EAS)
**/archive/
**/archives/
**/backup/
**/backups/
**/old/
**/old-builds/
**/temp/
**/tmp/
**/node_modules/
**/.git/
**/.expo/
**/coverage/
**/dist/
**/web-build/
**/.gradle/
**/.turbo/

# Exported installers, compressed backups and debug dumps
**/*.zip
**/*.rar
**/*.7z
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.gz
**/*.bak
**/*.old
**/*.log
**/*.tmp
**/*.apk
**/*.aab
**/*.ipa
**/*.hprof
**/*.dump

# Local media captures / recordings not used as app assets
**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
