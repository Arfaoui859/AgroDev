# AgroGrowth Mobile — environment configuration
#
# Copy this file to `.env` (gitignored) and adjust as needed. Expo only inlines
# variables whose names start with EXPO_PUBLIC_ at build time; keep that prefix.
#
# Only PUBLIC values belong here. Never put a Supabase service-role key or an AI
# provider API key in this file — the app talks to the AI services exclusively
# through the Express gateway, which holds those secrets server-side.

# Base URL of the Express API gateway.
# - Android emulator reaches the host machine through 10.0.2.2 (the default).
# - iOS simulator and web use http://localhost:5000 (the default).
# - A physical device must use the host machine's LAN IP, e.g.:
#     EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000
EXPO_PUBLIC_API_BASE_URL=

# Supabase project URL + anon key. The anon key is a PUBLIC key protected by
# Row Level Security; it is safe to ship in a client bundle. Defaults already
# point at the same project the web application uses.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Per-request network timeout (ms). Default: 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=

# Offline cache lifetime for list/detail reads (ms). Default: 21600000 (6h).
EXPO_PUBLIC_CACHE_TTL_MS=

# Longest edge (px) an image is downscaled to before upload. Default: 1280.
EXPO_PUBLIC_IMAGE_MAX_EDGE=

# JPEG quality used when re-encoding an image for upload. Default: 0.75.
EXPO_PUBLIC_IMAGE_QUALITY=
