{
  "name": "agrogrowth-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for AgroGrowth platform - Node.js + Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "tsc --skipLibCheck",
    "start": "tsx index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
     "ts-node": "^10.9.1",
     "tsx": "^4.7.0",
     "typescript": "^5.3.0"
    "express": "^4.18.2",
    "axios": "^1.7.7",
    "zod": "^3.23.8",
    "form-data": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@supabase/supabase-js": "^2.55.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.53.0",
    "prettier": "^3.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.9.0",
    "@types/cors": "^2.8.16",
    "@types/multer": "^1.4.11"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "Node",
    "Express",
    "TypeScript",
    "Supabase",
    "AI",
    "Backend",
    "AgroGrowth"
  ],
  "author": "AgroGrowth Team",
  "license": "MIT"
}
