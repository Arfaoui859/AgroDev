FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install only the CPU inference/runtime dependencies for this service.
# Do not pull the repository-wide TensorFlow/PyTorch training stack into production.
COPY image_diagnosis/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy common modules
COPY ai_common ./ai_common

# Copy service-specific files
COPY image_diagnosis ./image_diagnosis

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Create models directory
RUN mkdir -p /app/models

# Expose port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD sh -c "curl -f http://localhost:${PORT:-8003}/health || exit 1"

# Run the application
CMD ["sh", "-c", "uvicorn image_diagnosis.main:app --host 0.0.0.0 --port ${PORT:-8003}"]
