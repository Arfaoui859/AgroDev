FROM python:3.11-slim

WORKDIR /app

# Minimal system packages required by the Soil Analysis service.
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Use the exact ML runtime stack used to produce the committed model artifacts.
# The repository-wide requirements.txt pins older sklearn/joblib versions and
# installs unrelated heavyweight frameworks that this service does not need.
COPY soil_analysis/requirements-ml.txt ./requirements-ml.txt
RUN pip install --no-cache-dir -r requirements-ml.txt

# Shared LLM provider and advisory modules.
COPY ai_common ./ai_common

# Includes the production manifest and trained model artifacts.
COPY soil_analysis ./soil_analysis

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["sh", "-c", "uvicorn soil_analysis.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
