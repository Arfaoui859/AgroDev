{
  "version": 2,
  "name": "agrogrowth-platform",

  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "framework": "vite",
  "regions": ["fra1"],

  "functions": {
    "api/api.ts": {
      "maxDuration": 30
    }
  },

  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/api.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],

  "env": {
